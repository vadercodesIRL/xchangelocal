# Prevent execution of any scripts in the uploads directory.
# This directory holds user-uploaded images only — PHP must never run here.

<FilesMatch "\.(php|php3|php4|php5|php7|phtml|pl|py|cgi|shtml|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Disable PHP engine in this directory (belt-and-suspenders)
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

Options -Indexes -ExecCGI
